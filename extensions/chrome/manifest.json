{
  "manifest_version": 3,
  "name": "Ricekit",
  "version": "1.0.0",
  "description": "Live page theming powered by Ricekit. Injects --rk-* CSS variables into every page so Stylus userstyles (Catppuccin Ricekit bundle) render with your active theme.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
