{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "ricekit",
  "vars": {
    "foreground": "{{foreground}}",
    "background": "{{background}}",
    "black": "{{black}}",
    "red": "{{red}}",
    "green": "{{green}}",
    "yellow": "{{yellow}}",
    "blue": "{{blue}}",
    "magenta": "{{magenta}}",
    "cyan": "{{cyan}}",
    "white": "{{white}}",
    "brightBlack": "{{bright_black}}",
    "brightRed": "{{bright_red}}",
    "brightGreen": "{{bright_green}}",
    "brightYellow": "{{bright_yellow}}",
    "brightBlue": "{{bright_blue}}",
    "brightMagenta": "{{bright_magenta}}",
    "brightCyan": "{{bright_cyan}}",
    "brightWhite": "{{bright_white}}",
    "accent": "{{accent}}",
    "error": "{{error}}",
    "warning": "{{warning}}",
    "success": "{{success}}",
    "info": "{{info}}",
    "surface": "{{surface}}",
    "border": "{{border}}",
    "paletteMuted": "{{muted}}",
    "muted": "{{blend(background, foreground, 58%)}}",
    "dim": "{{blend(background, foreground, 46%)}}",
    "selectedBg": "{{blend(background, accent, 24%)}}",
    "userMessageBg": "{{blend(background, surface, 60%)}}",
    "customMessageBg": "{{blend(background, magenta, 18%)}}",
    "toolPendingBg": "{{blend(background, blue, 16%)}}",
    "toolSuccessBg": "{{blend(background, success, 16%)}}",
    "toolErrorBg": "{{blend(background, error, 16%)}}",
    "exportInfoBg": "{{blend(background, warning, 14%)}}"
  },
  "colors": {
    "accent": "accent",
    "border": "muted",
    "borderAccent": "accent",
    "borderMuted": "dim",
    "success": "success",
    "error": "error",
    "warning": "warning",
    "muted": "muted",
    "dim": "dim",
    "text": "foreground",
    "thinkingText": "muted",

    "selectedBg": "selectedBg",
    "userMessageBg": "userMessageBg",
    "userMessageText": "foreground",
    "customMessageBg": "customMessageBg",
    "customMessageText": "foreground",
    "customMessageLabel": "accent",
    "toolPendingBg": "toolPendingBg",
    "toolSuccessBg": "toolSuccessBg",
    "toolErrorBg": "toolErrorBg",
    "toolTitle": "accent",
    "toolOutput": "muted",

    "mdHeading": "accent",
    "mdLink": "blue",
    "mdLinkUrl": "muted",
    "mdCode": "cyan",
    "mdCodeBlock": "green",
    "mdCodeBlockBorder": "border",
    "mdQuote": "muted",
    "mdQuoteBorder": "border",
    "mdHr": "border",
    "mdListBullet": "accent",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "red",
    "toolDiffContext": "muted",

    "syntaxComment": "muted",
    "syntaxKeyword": "accent",
    "syntaxFunction": "blue",
    "syntaxVariable": "foreground",
    "syntaxString": "green",
    "syntaxNumber": "warning",
    "syntaxType": "cyan",
    "syntaxOperator": "accent",
    "syntaxPunctuation": "muted",

    "thinkingOff": "muted",
    "thinkingMinimal": "blue",
    "thinkingLow": "cyan",
    "thinkingMedium": "cyan",
    "thinkingHigh": "accent",
    "thinkingXhigh": "error",
    "bashMode": "green"
  },
  "export": {
    "pageBg": "background",
    "cardBg": "surface",
    "infoBg": "exportInfoBg"
  }
}
